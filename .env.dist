OZON_START_TIME=07:30
WILDBERRIES_START_TIME=08:00
TZ=Europe/Moscow
PROXY_URL=http://user@pass:host:port
# -u flag or empty; managed by CI deploy workflow_dispatch checkbox in production
RUN_FLAGS=-u
# Persistent Ozon login profile + its fingerprint. Defaults are fine; created by
# scripts/ozon_login.py and mounted into the container at /app/data
OZON_DATA_DIR=data
OZON_PROFILE_DIR=data/ozon_profile
OZON_FINGERPRINT_PATH=data/ozon_fingerprint.json
